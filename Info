    <title>Infografía - Fundamentos de la Investigación Científica</title>
    <style>
        /* Estilos generales y configuración de dimensiones tipo Canva (1080x1920) */
        body {
            margin: 0;
            padding: 20px;
            background-color: #d1d5db; /* Fondo exterior gris para contraste */
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Arial', sans-serif;
        }

        .infografia-container {
            width: 1080px;
            height: 1920px;
            background-color: #ffffff;
            padding: 60px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        /* Encabezado */
        .header {
            text-align: center;
            border-bottom: 4px solid #002b5c;
            padding-bottom: 20px;
        }

        .header h1 {
            font-size: 42px;
            color: #002b5c;
            margin: 0 0 10px 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header h2 {
            font-size: 24px;
            color: #4a5568;
            margin: 0;
            font-weight: normal;
        }

        /* Sección de Definiciones (Grid 2x2) */
        .definiciones-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-top: 40px;
        }

        .card {
            background-color: #f8f9fa;
            border-left: 8px solid #002b5c;
            padding: 25px;
            border-radius: 4px;
        }

        .card h3 {
            font-size: 26px;
            color: #002b5c;
            margin-top: 0;
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .card p {
            font-size: 19px;
            color: #1a202c;
            line-height: 1.6;
            text-align: justify;
            margin: 0;
        }

        .cita {
            display: block;
            margin-top: 10px;
            font-size: 16px;
            color: #4a5568;
            font-weight: bold;
        }

        /* Sección de Tabla Comparativa */
        .tabla-container {
            margin-top: 50px;
        }

        .tabla-container h3 {
            font-size: 28px;
            color: #002b5c;
            text-align: center;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 16px;
            line-height: 1.5;
        }

        th {
            background-color: #002b5c;
            color: #ffffff;
            padding: 15px;
            text-align: left;
            font-weight: bold;
            border: 1px solid #002b5c;
        }

        td {
            padding: 15px;
            border: 1px solid #cbd5e0;
            color: #1a202c;
            text-align: justify;
            vertical-align: top;
        }

        tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .dimension {
            font-weight: bold;
            color: #002b5c;
            background-color: #edf2f7;
            width: 20%;
        }

        /* Referencias y Pie de página */
        .referencias {
            margin-top: 40px;
            border-top: 2px solid #cbd5e0;
            padding-top: 20px;
        }

        .referencias h4 {
            font-size: 18px;
            color: #002b5c;
            margin-top: 0;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .referencias p {
            font-size: 14px;
            color: #2d3748;
            line-height: 1.5;
            margin-bottom: 8px;
            text-align: justify;
            padding-left: 20px;
            text-indent: -20px; /* Sangría francesa */
